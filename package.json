  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0"
  }
}
