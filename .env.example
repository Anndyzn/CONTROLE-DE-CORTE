# Copie para .env e preencha localmente. Não envie senhas ou este arquivo preenchido ao GitHub.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Opcional: conexão direta ou Session Pooler do mesmo projeto, porta 5432.
# Quando vazio, o backup usa DATABASE_URL.
BACKUP_DATABASE_URL=

# Recuperação: banco SEPARADO, com schema public vazio. Nunca use a conexão de produção aqui.
RESTORE_DATABASE_URL=

# Opcional: pasta com pg_dump/pg_restore/psql nativos, da versão compatível com o servidor.
# Sem essas ferramentas, os comandos usam a imagem oficial postgres pelo Docker Desktop.
PG_BIN_DIR=
